rules_version = '2';

// Regras de segurança do Cloud Firestore — DoaPet
// Cole estas regras no Firebase Console > Firestore Database > Rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis de usuário: cada um edita apenas o próprio perfil
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Pets: leitura pública para usuários autenticados;
    // criação apenas pelo dono; edição/remoção apenas pelo dono
    match /pets/{petId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Alertas SOS Rua: qualquer usuário autenticado cria e lê;
    // apenas o autor pode alterar status ou excluir
    match /sos_alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // Eventos (feiras/campanhas): leitura para autenticados,
    // criação/edição apenas pelo organizador
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organizerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.organizerId == request.auth.uid;
    }

    // Clínicas veterinárias: catálogo público somente leitura
    // (populado via console admin ou seed)
    match /vet_clinics/{clinicId} {
      allow read: if true;
      allow write: if false; // gerenciar via Firebase Console / Admin SDK
    }

    // Chats: apenas participantes podem ler/escrever
    match /chats/{chatId} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      // Mensagens dentro do chat
      match /messages/{messageId} {
        function isParticipant() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participants
            .hasAny([request.auth.uid]);
        }
        allow read, create: if request.auth != null && isParticipant()
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; // mensagens são imutáveis
      }
    }
  }
}