rules_version = '2';

// Regras de segurança do Firebase Storage — DoaPet
// Cole estas regras no Firebase Console > Storage > Rules

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos dos pets: apenas o dono do pet faz upload;
    // leitura pública para exibição nos cards
    match /pets/{petId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024 // máx. 5 MB
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Fotos de alertas SOS
    match /sos_alerts/{alertId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Fotos de perfil
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}